{
  "name": "sort-unique-lines",
  "displayName": "Sort & Unique Lines",
  "description": "Sort lines and remove duplicates in one keystroke. Select text (or nothing for the whole file), press a key, done.",
  "version": "1.1.2",
  "publisher": "labinator",
  "license": "AGPL-3.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/LabinatorSolutions/sort-unique-lines"
  },
  "homepage": "https://github.com/LabinatorSolutions/sort-unique-lines#readme",
  "bugs": {
    "url": "https://github.com/LabinatorSolutions/sort-unique-lines/issues"
  },
  "icon": "icon.png",
  "galleryBanner": {
    "color": "#1e1e1e",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.125.0"
  },
  "categories": [
    "Formatters",
    "Other"
  ],
  "keywords": [
    "sort",
    "unique",
    "deduplicate",
    "lines",
    "remove duplicates"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "sort-unique-lines.run",
        "title": "Sort & Unique Lines"
      }
    ],
    "keybindings": [
      {
        "command": "sort-unique-lines.run",
        "key": "alt+w",
        "when": "editorTextFocus && !editorReadonly"
      }
    ],
    "configuration": {
      "title": "Sort & Unique Lines",
      "properties": {
        "sort-unique-lines.sortOrder": {
          "type": "string",
          "enum": [
            "ascending",
            "descending"
          ],
          "default": "ascending",
          "description": "Sort direction for lines."
        },
        "sort-unique-lines.caseSensitive": {
          "type": "boolean",
          "default": false,
          "description": "If true, sort and deduplication treat uppercase and lowercase as different."
        },
        "sort-unique-lines.removeBlankLines": {
          "type": "boolean",
          "default": true,
          "description": "Remove empty/whitespace-only lines from the result."
        },
        "sort-unique-lines.trimLines": {
          "type": "boolean",
          "default": true,
          "description": "Trim leading and trailing whitespace from each line before sorting."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "bun run compile",
    "compile": "tsc -p ./",
    "test": "bun test",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "ci": "biome ci .",
    "build": "bun run format && bun run lint && bun run compile && bun run test && bun run package",
    "update": "bunx npm-check-updates -u && bun install",
    "package": "vsce package",
    "publish": "vsce publish"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.8",
    "@types/vscode": "^1.125.0",
    "@vscode/vsce": "^3.9.2",
    "typescript": "^7.0.2"
  }
}
